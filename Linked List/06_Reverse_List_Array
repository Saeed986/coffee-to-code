void ReverseList()
    {
        Nodes *temp=Head;
        int count=numberOfNodes();
        int arr[count];
        int i=0;
        for(i=0;i<count;i++)
        {
            arr[i]=temp->val;
            temp=temp->Next;
        }
        temp=Head;
        for(i=count-1;i>=0;i--)
        {
            temp->val=arr[i];
            temp=temp->Next;
        }
    }
